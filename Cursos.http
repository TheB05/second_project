@baseUrl = http://localhost:5000

### Obtener todos los cursos
GET {{baseUrl}}/api/cursos
Accept: application/json

### Crear un curso
POST {{baseUrl}}/api/cursos
Content-Type: application/json

{
  "codigo": "DIS301",
  "nombre": "Diseño de interfaces",
  "area": "Diseño",
  "horas": 40,
  "cupoMaximo": 24,
  "fechaInicio": "2026-10-01"
}

### Error 400: valores fuera de rango
POST {{baseUrl}}/api/cursos
Content-Type: application/json

{
  "codigo": "",
  "nombre": "Curso inválido",
  "area": "Diseño",
  "horas": 0,
  "cupoMaximo": 0,
  "fechaInicio": null
}

### Obtener el curso creado
GET {{baseUrl}}/api/cursos/1
Accept: application/json

### Actualizar un curso
PUT {{baseUrl}}/api/cursos/1
Content-Type: application/json

{
  "codigo": "INF101",
  "nombre": "Introducción a la programación actualizada",
  "area": "Informática",
  "horas": 48,
  "cupoMaximo": 32,
  "fechaInicio": "2026-10-05"
}

### Error 400: actualización inválida
PUT {{baseUrl}}/api/cursos/1
Content-Type: application/json

{
  "codigo": "",
  "nombre": "Curso inválido",
  "area": "Informática",
  "horas": 0,
  "cupoMaximo": 0,
  "fechaInicio": null
}

### Eliminar un curso
DELETE {{baseUrl}}/api/cursos/1

### Error 404: curso inexistente
DELETE {{baseUrl}}/api/cursos/999

### Error 404: curso inexistente
GET {{baseUrl}}/api/cursos/999
Accept: application/json
